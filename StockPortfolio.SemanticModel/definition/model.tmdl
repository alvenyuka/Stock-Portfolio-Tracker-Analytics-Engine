model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Holdings","Ledger","SectorAllocation","KPIs"]

annotation __PBI_TimeIntelligenceEnabled = 1

ref table Holdings
ref table Ledger
ref table SectorAllocation
ref table KPIs
ref table _Measures

ref cultureInfo en-US

